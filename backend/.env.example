# ===========================================================================
# SimpleInvoice Backend — environment configuration
# Copy to `.env` and adjust. NEVER commit a real .env with secrets.
# ===========================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins (frontend URL).
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=simple_invoice
DB_LOGGING=false

# --- Authentication (JWT) ---
# Use a long, random secret in production.
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime in SECONDS. Defaults to 3600 if omitted.
JWT_EXPIRES_IN=3600

# --- Seed default user (created by `npm run seed`) ---
SEED_USER_EMAIL=admin@simpleinvoice.io
SEED_USER_PASSWORD=Password123!
SEED_USER_FULLNAME=Demo Admin
